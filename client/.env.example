# Base URL for the backend API.
# Use an absolute URL for a separate API host, or /api for same-origin deployments.
VITE_API_BASE_URL=http://localhost:5000/api

# Optional base path when deploying the SPA under a subdirectory.
# VITE_BASE_PATH=/

# Optional dev/preview proxy target used when VITE_API_BASE_URL is /api.
# VITE_DEV_PROXY_TARGET=http://localhost:5000
