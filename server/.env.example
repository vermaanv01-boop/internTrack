PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/interntrack
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Optional production hardening settings.
# TRUST_PROXY=true
# JSON_BODY_LIMIT=1mb
# LOG_LEVEL=info
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
# SENSITIVE_RATE_LIMIT_MAX=60
# Optional. Defaults to server/storage/resumes. Keep this outside public/static folders.
# RESUME_UPLOAD_DIR=
