PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/interntrack
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# HR email verification. SMTP values must be supplied through the environment.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=InternTrack AI <no-reply@example.com>
# Defaults to CLIENT_URL/verify-email when omitted.
# EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
# EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
# EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
# EMAIL_VERIFICATION_RATE_LIMIT_MAX=20
# EMAIL_VERIFICATION_RESEND_RATE_LIMIT_WINDOW_MS=900000
# EMAIL_VERIFICATION_RESEND_RATE_LIMIT_MAX=5
# Optional production hardening settings.
# TRUST_PROXY=true
# JSON_BODY_LIMIT=1mb
# LOG_LEVEL=info
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
# SENSITIVE_RATE_LIMIT_MAX=60
# Optional. Defaults to server/storage/resumes. Keep this outside public/static folders.
# RESUME_UPLOAD_DIR=
